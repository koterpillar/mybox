#!/usr/bin/env bash
# Verify that a commit message follows Conventional Commits, as needed by
# Semantic Release. Usage: check-commit-msg <message-file>

set -euo pipefail

HEADER=$(grep -vE '^#' "$1" | head -n 1)

# Messages generated by Git itself.
if [[ "$HEADER" =~ ^(Merge|Revert|fixup!|squash!|amend!)\  ]]
then
  exit 0
fi

TYPES='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
PATTERN="^($TYPES)(\([a-z0-9._/-]+\))?!?: [^ ].*$"

if ! [[ "$HEADER" =~ $PATTERN ]] || [ "${#HEADER}" -gt 100 ]
then
  cat >&2 <<MSG
Invalid commit message header:

  $HEADER

Expected: type(scope): message (at most 100 characters), where type is one of:
  ${TYPES//|/, }
Scope is optional. Use "!" before the colon or a "BREAKING CHANGE:" footer for
breaking changes.
MSG
  exit 1
fi
